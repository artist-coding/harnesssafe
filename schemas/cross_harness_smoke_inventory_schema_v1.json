{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://safety-bench.local/schema/cross-harness-smoke-inventory-v1.json",
  "title": "Safety Bench Cross-Harness Conformance Smoke Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "inventory_id",
    "harness_id",
    "binding_contract_version",
    "event_ir_version",
    "target_case_count",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_name": {
      "const": "safety_bench_conformance_smoke_inventory"
    },
    "schema_version": {
      "const": 1
    },
    "inventory_id": {
      "$ref": "#/definitions/identifier"
    },
    "harness_id": {
      "const": "codex"
    },
    "binding_contract_version": {
      "const": 1
    },
    "event_ir_version": {
      "const": 1
    },
    "target_case_count": {
      "type": "integer",
      "minimum": 12,
      "maximum": 16
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "common",
        "native",
        "selected",
        "conditional",
        "blocked_contract"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "common": {"type": "integer", "minimum": 0},
        "native": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0},
        "conditional": {"type": "integer", "minimum": 0},
        "blocked_contract": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/smoke_case"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
    },
    "capability": {
      "enum": [
        "headless_execution",
        "structured_trace",
        "workspace_isolation",
        "instruction_loading",
        "skill_discovery",
        "skill_activation_trace",
        "mcp_configuration",
        "mcp_health_trace",
        "mcp_tool_trace",
        "fresh_process",
        "durable_memory_write",
        "durable_memory_retrieval",
        "session_resume",
        "session_compaction",
        "subagent_delegation",
        "artifact_hash_provenance",
        "control_isolation"
      ]
    },
    "event_type": {
      "enum": [
        "instruction.loaded",
        "skill.discovered",
        "skill.activated",
        "mcp.server_initialized",
        "mcp.tool_requested",
        "mcp.tool_result",
        "file.read",
        "file.write",
        "memory.written",
        "memory.retrieved",
        "session.started",
        "session.compacted",
        "session.resumed",
        "agent.spawned",
        "agent.completed",
        "artifact.handoff"
      ]
    },
    "smoke_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_dir",
        "case_meta_sha256",
        "suite",
        "surface_class",
        "comparison_group",
        "expected_binding_class",
        "selection_status",
        "purpose",
        "required_capabilities",
        "required_event_types",
        "blocking_issues"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_dir": {
          "type": "string",
          "pattern": "^runs/active/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "case_meta_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "surface_class": {
          "enum": ["common", "native"]
        },
        "comparison_group": {
          "$ref": "#/definitions/identifier"
        },
        "expected_binding_class": {
          "enum": ["D", "M", "N/A"]
        },
        "selection_status": {
          "enum": ["selected", "conditional", "blocked_contract"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "required_event_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/event_type"
          }
        },
        "blocking_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
